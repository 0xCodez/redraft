{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "landing",
  "headers": [
    {
      "source": "/redraft.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Redraft.zip\""
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "cleanUrls": true
}
